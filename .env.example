# Neon Lakebase Postgres
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Branch
NEON_BRANCH=production
NEON_BRANCH_ID=br-xxx

# Neon Auth
NEON_AUTH_BASE_URL=https://auth.neon.tech/xxx
NEON_AUTH_JWKS_URL=https://auth.neon.tech/xxx/.well-known/jwks.json

# Neon Functions
NEON_FUNCTION_HOST_SUFFIX=.compute.c-8.eu-central-1.aws.neon.tech

# Neon Object Storage
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_ENDPOINT_URL_S3=https://storage.neon.tech/xxx
AWS_REGION=eu-central-1

# Neon AI Gateway
NEON_AI_GATEWAY_TOKEN=xxx
NEON_AI_GATEWAY_BASE_URL=https://gateway.neon.tech/xxx

# Neon Realtime
NEON_REALTIME_URL=wss://realtime.neon.tech/xxx
NEON_REALTIME_SECRET=xxx

# Cloudflare R2 Storage (Bucket: vision)
R2_ACCOUNT_ID=73b22fc72b6c98643bbab88ae6dbbfad
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=vision
R2_ENDPOINT=https://73b22fc72b6c98643bbab88ae6dbbfad.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxx.r2.dev

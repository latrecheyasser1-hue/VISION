  {
    "text": "حذفها",
    "start": 6.356415999999999,
    "end": 7.1014159999999995
  },
  {
    "text": "لنفكك ما يحدث عند تسجيل",
    "start": 7.968333,
    "end": 10.014331999999998
  },
  {
    "text": "عملية بيع",
    "start": 9.894333,
    "end": 11.124041

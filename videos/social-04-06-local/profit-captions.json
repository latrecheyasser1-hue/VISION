[
  {
    "text": "مئة ألف دينار من المبيعات",
    "start": 0.33499999999999996,
    "end": 2.805
  },
  {
    "text": "رقم جميل لكنه لا يعني",
    "start": 3.56,
    "end": 6.83
  },
  {
    "text": "مئة ألف من الأرباح",
    "start": 6.722499999999999,
    "end": 8.504999999999999
  },
  {
    "text": "لنأخذ مثالًا مبسطًا السلع المباعة",
    "start": 9.501667000000001,
    "end": 12.871667
  },
  {
    "text": "كلّفت ستين ألف دينار يتبقّى",
    "start": 12.764167,
    "end": 15.546667
  },
  {
    "text": "أربعون ألفًا قبل مصاريف التشغيل",
    "start": 15.439167000000001,
    "end": 18.559167000000006
  },
  {
    "text": "نطرح الآن خمسة عشر ألفًا",
    "start": 19.568333,
    "end": 21.863333
  },
  {
    "text": "لمصاريف الفترة نفسها المتبقي خمسة",
    "start": 21.755833,
    "end": 26.375833
  },
  {
    "text": "وعشرون ألف دينار",
    "start": 26.268333,
    "end": 28.000833
  },
  {
    "text": "يجمع النظام المبيعات والتكاليف والمصاريف",
    "start": 29.001667,
    "end": 32.484167
  },
  {
    "text": "لكن إن نسيت تسجيل جزء",
    "start": 33.239167,
    "end": 35.859167
  },
  {
    "text": "منها فستحصل على صورة ناقصة",
    "start": 35.751667,
    "end": 38.834166999999994
  },
  {
    "text": "حتى لو كانت العملية الحسابية",
    "start": 39.589167,
    "end": 42.059167
  },
  {
    "text": "صحيحة",
    "start": 41.951667,
    "end": 42.834167
  }
]
[
  {
    "text": "بعت بمية ألف دينار ربحت",
    "start": 0.2157142857142857,
    "end": 2.3023571428571428
  },
  {
    "text": "مية ألف ماشي هكّا",
    "start": 2.311992857142857,
    "end": 3.888294642857142
  },
  {
    "text": "في مثال مبسّط السلعة اللي",
    "start": 4.482381285714285,
    "end": 6.263853607142857
  },
  {
    "text": "بعتها كلّفتك ستين ألف يبقاولك",
    "start": 6.2734893214285705,
    "end": 8.687550928571428
  },
  {
    "text": "أربعين ألف",
    "start": 8.697186642857142,
    "end": 9.544619678571427
  },
  {
    "text": "وعندك خمسة عشر ألف مصاريف",
    "start": 10.115714285714287,
    "end": 11.90682232142857
  },
  {
    "text": "تخص نفس الفترة يبقاولك خمسة",
    "start": 11.916458035714285,
    "end": 14.118690178571429
  },
  {
    "text": "وعشرين ألف",
    "start": 14.128288392857144,
    "end": 14.898674999999999
  },
  {
    "text": "دور البرنامج يجمع المبيعات يربطها",
    "start": 15.482381285714286,
    "end": 18.024642
  },
  {
    "text": "بالتكاليف ويحسبلك واش بقى حسب",
    "start": 18.034241107142858,
    "end": 20.354962535714286
  },
  {
    "text": "البيانات اللي دخلتها",
    "start": 20.36459825,
    "end": 21.539412535714284
  },
  {
    "text": "بصح إذا التكاليف ناقصة حتى",
    "start": 22.115714285714283,
    "end": 24.00976071428571
  },
  {
    "text": "الحساب الصحيح يعطيك صورة ناقصة",
    "start": 24.019396428571426,
    "end": 26.147558035714283
  }
]
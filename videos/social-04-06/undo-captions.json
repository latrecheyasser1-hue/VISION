[
  {
    "text": "زر صغير مكتوب فيه تراجع",
    "start": 0.2157142857142857,
    "end": 2.1994562499999994
  },
  {
    "text": "يقدر يحتاج خدمة أكثر من",
    "start": 2.3601705357142855,
    "end": 3.9875874999999996
  },
  {
    "text": "حذف",
    "start": 3.9971866071428566,
    "end": 4.392015178571428
  },
  {
    "text": "مثلاً سجّلت بيعة المخزون نقص",
    "start": 4.982381285714285,
    "end": 7.608272357142856
  },
  {
    "text": "الفاتورة تسجّلت والمبلغ دخل في",
    "start": 7.714188428571428,
    "end": 10.13122682142857
  },
  {
    "text": "التقارير",
    "start": 10.140862535714284,
    "end": 10.843838428571427
  },
  {
    "text": "كي تلغيها ما يكفيش نخفي",
    "start": 11.415714285714285,
    "end": 13.07200089285714
  },
  {
    "text": "الفاتورة لازم نرجّع الكمية ونصحّح",
    "start": 13.081636607142856,
    "end": 15.659425892857142
  },
  {
    "text": "أثر العملية على الحسابات",
    "start": 15.669024107142855,
    "end": 17.33498392857143
  },
  {
    "text": "ونخليو سجل يبيّن واش تبدّل",
    "start": 17.915714285714284,
    "end": 19.928325
  },
  {
    "text": "ووقتاش وشكون دار التغيير",
    "start": 20.04387589285714,
    "end": 22.287588392857142
  },
  {
    "text": "لهذا البرمجة ماشي غير زر",
    "start": 22.849047285714285,
    "end": 24.601650857142857
  },
  {
    "text": "يخدم لازم حتى أثر الضغطة",
    "start": 24.611286571428572,
    "end": 26.69793032142857
  },
  {
    "text": "يكون محسوب",
    "start": 26.707566035714287,
    "end": 27.61273657142857
  }
]
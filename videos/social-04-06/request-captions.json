[
  {
    "text": "ضغطة وحدة على اطلب بصح",
    "start": 0.2157142857142857,
    "end": 2.206078571428571
  },
  {
    "text": "واش يصرا وراها",
    "start": 2.215676785714286,
    "end": 3.409761607142857
  },
  {
    "text": "الواجهة اللي تشوفها تجمع اختياراتك",
    "start": 3.9823812857142857,
    "end": 6.38018575
  },
  {
    "text": "وتبعث الطلب للسيرفر",
    "start": 6.5631473571428565,
    "end": 7.920922357142857
  },
  {
    "text": "السيرفر يتأكّد من المعلومات يحسب",
    "start": 8.482381285714286,
    "end": 10.841643785714286
  },
  {
    "text": "السعر ويشوف إذا السلعة متوفرة",
    "start": 10.851279499999999,
    "end": 13.172038428571428
  },
  {
    "text": "إذا كلش صحيح يسجّل الطلب",
    "start": 13.749047285714287,
    "end": 15.530519607142857
  },
  {
    "text": "في قاعدة البيانات ويرجعلك التأكيد",
    "start": 15.540155321428571,
    "end": 18.140155321428573
  },
  {
    "text": "هذي هي الرحلة واجهة تتعامل",
    "start": 18.715714285714284,
    "end": 20.81500714285714
  },
  {
    "text": "معاها سيرفر يعالج وقاعدة بيانات",
    "start": 20.824605357142858,
    "end": 23.674976785714286
  },
  {
    "text": "تحفظ",
    "start": 23.6846125,
    "end": 24.30090714285714
  }
]
      "start": 0,
      "duration": 8.6,
      "sourceStart": 0,
      "sourceDuration": 14.413,
      "text": "\u0644\u0643\u0644 \u0646\u0634\u0627\u0637 \u0637\u0631\u064a\u0642\u0629 \u0639\u0645\u0644\u0647. \u0648\u0645\u0639 \u062a\u0639\u062f\u062f \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0648\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a\u060c \u062a\u0638\u0647\u0631 \u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u062c\u062f\u064a\u062f\u0629 \u0644\u0644\u062a\u0646\u0638\u064a\u0645 \u0648\u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629."
    },
    {
      "start": 8.6,
      "duration": 8.266666666666667,
      "sourceStart": 14.413,
      "sourceDuration": 14.038,
      "text": "\u0641\u064a \u0641\u064a\u062c\u0646\u060c \u0646\u0628\u062f\u0623 \u0628\u0641\u0647\u0645 \u0646\u0634\u0627\u0637\u0643: \u0643\u064a\u0641 \u062a\u0639\u0645\u0644\u060c \u0648\u0623\u064a\u0646 \u062a\u062a\u0643\u0631\u0631 \u0627\u0644\u0635\u0639\u0648\u0628\u0627\u062a\u060c \u0648\u0645\u0627 \u0627\u0644\u0630\u064a \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u062a\u062d\u0633\u064a\u0646\u0647."
    },
    {
      "start": 16.866666666666667,
      "duration": 3.7,
      "sourceStart": 28.451,
      "sourceDuration": 8,
      "text": "\u062b\u0645 \u0646\u0628\u0631\u0645\u062c \u0644\u0643 \u0646\u0638\u0627\u0645\u0627\u064b \u064a\u0646\u0627\u0633\u0628 \u0645\u062a\u0637\u0644\u0628\u0627\u062a\u0643."

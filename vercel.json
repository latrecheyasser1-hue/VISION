{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://admin.digitalvisiondz.com",
      "permanent": true
    },
    {
      "source": "/ADMIN",
      "destination": "https://admin.digitalvisiondz.com",
      "permanent": true
    },
    {
      "source": "/admin/",
      "destination": "https://admin.digitalvisiondz.com",
      "permanent": true
    },
    {
      "source": "/ADMIN/",
      "destination": "https://admin.digitalvisiondz.com",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.digitalvisiondz.com"
        }
      ],
      "destination": "/api/admin-entry"
    }
  ]
}

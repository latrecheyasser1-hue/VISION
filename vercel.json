{
  "version": 2,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ADMIN",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ADMIN/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.digitalvisiondz.com"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "digitalvisiondz.com"
        }
      ],
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.digitalvisiondz.com"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
